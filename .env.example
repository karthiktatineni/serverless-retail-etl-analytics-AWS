AWS_PROFILE=etl-project
AWS_REGION=ap-southeast-2

S3_BUCKET=orders-etl-pipeline-2026-11-7f3a9c

ATHENA_DATABASE=orders_analytics_db
ATHENA_TABLE=orders
ATHENA_WORKGROUP=orders-etl-workgroup

ATHENA_OUTPUT_LOCATION=s3://orders-etl-pipeline-2026-11-7f3a9c/athena-results/

QUALITY_REPORT_PREFIX=reports/
INSIGHTS_PREFIX=reports/insights/

# Cache Athena/Glue/S3 results for 1 hour (3600s) to stay well within the $5 AWS budget
DASHBOARD_CACHE_TTL_SECONDS=3600

# Render-only AWS credentials (set in Render Dashboard -> Environment, NEVER commit real keys):
# Leave AWS_PROFILE empty on Render and provide read-only credentials scoped to docs/render_readonly_policy.json
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
